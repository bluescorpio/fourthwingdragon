# Public site URL used for canonical links, sitemap, and share text.
NEXT_PUBLIC_SITE_URL=https://cognitivebench.com

# Optional public contact address shown on Privacy and Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to "true" only when an analytics provider is intentionally enabled.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Set to "true" on preview deployments to discourage indexing via robots.ts.
NEXT_PUBLIC_NOINDEX=false
