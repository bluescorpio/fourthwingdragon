---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title:string; description:string; breadcrumbs?:{name:string;href:string}[]; type?:string }
const {title,description,breadcrumbs=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site ?? 'https://fourthwingdragon.com');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.href,Astro.site ?? 'https://fourthwingdragon.com')}))})}/></head><body><SiteHeader/><main><Breadcrumbs items={breadcrumbs}/><slot/></main><SiteFooter/></body></html>
