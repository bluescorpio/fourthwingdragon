---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
interface Props {
  title: string;
  description: string;
  breadcrumbs?: { name: string; href: string }[];
  subscribe?: boolean;
}
const { title, description, breadcrumbs = [], subscribe = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://fourthwingdragon.com');
const trail = [{ name: 'Home', href: '/' }, ...breadcrumbs.filter(b => b.href !== '/')];
const breadcrumbData = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    item: new URL(b.href, Astro.site ?? 'https://fourthwingdragon.com').href,
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E1L018XWER"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E1L018XWER');
    </script>
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z56g8nlcey");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FourthWingDragon — Unofficial Empyrean fan reference" />
    <script async defer data-domain="fourthwingdragon.com" src="https://plausible.io/js/script.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <Breadcrumbs items={trail} /><slot />
      {subscribe && <SubscribeForm />}
    </main>
    <SiteFooter />
  </body>
</html>
