---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import InfoCard from '../components/InfoCard.astro';
import RelationTable from '../components/RelationTable.astro';
import RelatedReading from '../components/RelatedReading.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { show } from '../lib/fields';
interface Props {
  entry: CollectionEntry<'characters'>;
  noindex?: boolean;
  headings: { depth: number; slug: string; text: string }[];
  liveSlugs: string[];
  dateModified?: string;
}
const { entry, noindex = false, headings, liveSlugs, dateModified } = Astro.props;
const d = entry.data;
const fields: [string, string][] = [
  ['Full name', show(d.fullName)], ['Role', show(d.role)],
  ['Squad', show(d.squad)], ['Wing', show(d.wing)], ['Signet', show(d.signet)],
  ['Dragon', show(d.dragon)], ['Dragon color', show(d.dragonColor)],
  ['First appearance', show(d.firstAppearance === 'unknown' ? undefined : d.firstAppearance?.replaceAll('-', ' '))],
  ['Home province', show(d.homeProvince)], ['Status', show(d.status)],
];
const person = { '@context': 'https://schema.org', '@type': 'Person', name: d.fullName ?? d.knownAs };
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.title,
  dateModified,
  author: { '@type': 'Organization', name: 'FourthWingDragon' },
};
---
<BaseLayout title={d.title} description={d.description} noindex={noindex}
  breadcrumbs={[{ name: 'Characters', href: '/fourth-wing-characters/' }, { name: d.knownAs, href: `/characters/${d.slugName}/` }]}>
  <article>
    <header>
      <div class="portrait-frame" aria-hidden="true">{d.knownAs.charAt(0)}</div>
      <h1>{d.knownAs}: Fourth Wing Character Guide</h1>
    </header>
    <InfoCard fields={fields} />
    <TableOfContents items={headings.filter(h => h.depth === 2).map(h => [h.text, h.slug])} />
    <div class="prose"><slot /></div>
    <RelationTable related={d.related} liveSlugs={liveSlugs} />
    <RelatedReading slug={d.slugName} related={d.related} liveSlugs={liveSlugs} />
    <script type="application/ld+json" set:html={JSON.stringify(person).replaceAll('<', '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(article).replaceAll('<', '\\u003c')} />
  </article>
</BaseLayout>
