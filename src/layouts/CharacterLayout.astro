---
import BaseLayout from './BaseLayout.astro'; import InfoCard from '../components/InfoCard.astro'; import RelationTable from '../components/RelationTable.astro'; import Disclaimer from '../components/Disclaimer.astro'; import RelatedReading from '../components/RelatedReading.astro';
const {entry,body}=Astro.props; const d=entry.data; const hidden=(v:string)=>v==='TBD'; const fields=[['Full name',d.fullName],['Role',d.role],['Squad',d.squad],['Wing',d.wing],['Signet',d.signet],['Dragon',d.dragon],['Dragon color',d.dragonColor],['First appearance',d.firstAppearance],['Home province',d.homeProvince],['Status',d.status]].filter(([,v])=>!hidden(v));
---
<BaseLayout title={d.title} description={d.description} breadcrumbs={[{name:'Home',href:'/'},{name:'Characters',href:'/fourth-wing-characters/'},{name:d.knownAs,href:`/characters/${d.slugName}/`}]}> <article><header><img src={d.portrait} alt={`${d.knownAs} portrait`} width="640" height="360" loading="eager" fetchpriority="high"/><h1>{d.knownAs}: Fourth Wing Character Guide</h1><p class="muted">A source-conscious guide to {d.knownAs}, with canon facts separated from research placeholders.</p></header><InfoCard fields={fields}/><nav class="bordered" aria-label="Table of contents"><strong>On this page</strong><ul>{['Background and Origins','Signet and Powers',d.knownAs==='Violet'?'Her Dragon':'His Dragon','Personality and Relationships','Story Arc: Fourth Wing','Story Arc: Iron Flame','Story Arc: Onyx Storm','Fan Theories and Debates'].map((x)=><li><a href={`#${x.toLowerCase().replaceAll(' ','-')}`}>{x}</a></li>)}</ul></nav><div class="prose"><slot/></div><RelationTable related={d.related}/><RelatedReading slug={d.slugName}/><Disclaimer/></article></BaseLayout>
