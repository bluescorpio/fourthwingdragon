---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isKnown } from '../lib/fields';
const characters = await getCollection('characters', ({ data }) => data.contentStatus === 'verified');
---
<BaseLayout title="Fourth Wing Characters — Empyrean Profiles and Story Guide" description="Browse published Fourth Wing character profiles, with source notes, relationships and links to the wider Empyrean dragon reference." breadcrumbs={[{ name: 'Characters', href: '/fourth-wing-characters/' }]}>
  <h1>Fourth Wing Characters</h1>
  {characters.length === 0 && <p class="muted">Character profiles are undergoing source review. No profiles are published yet.</p>}
  <div class="grid cards">{characters.map(c => <a class="bordered" href={`/characters/${c.data.slugName}/`}>
    <h2>{c.data.knownAs}</h2>{isKnown(c.data.role) && <p>{c.data.role}</p>}
  </a>)}</div>
  <p>Explore the <a href="/dragons/">dragon type index</a> or return to the <a href="/">Empyrean guide</a>.</p>
</BaseLayout>
