---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content'; const characters=await getCollection('characters');
---
<BaseLayout title="Fourth Wing Characters — Empyrean Character Guide" description="Browse individual Fourth Wing character pages with source-conscious profiles, relationships and story placeholders." breadcrumbs={[{name:'Characters',href:'/fourth-wing-characters/'}]}><h1>Fourth Wing Characters</h1><p class="muted">Each profile keeps unresolved details visible to editors while avoiding unsupported canon claims.</p><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:2rem">{characters.map(c=><a class="bordered" href={`/characters/${c.data.slugName}/`}><h2>{c.data.knownAs}</h2><p>{c.data.role}</p></a>)}</div></BaseLayout>
