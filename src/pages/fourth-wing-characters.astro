---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublishedCharacter, isPublishedPath } from '../lib/publication';
import { getCollection } from 'astro:content';
import { isKnown } from '../lib/fields';
const characters = await getCollection('characters', isPublishedCharacter);
---
<BaseLayout title="Fourth Wing Characters: Publisher References and Profiles" description="Browse Fourth Wing character names, publisher descriptions, and links to individual character reference pages and the dragon index." breadcrumbs={[{ name: 'Characters', href: '/fourth-wing-characters/' }]}>
  <h1>Fourth Wing Characters</h1>
  {characters.length === 0 && <p class="muted">Character profiles are undergoing source review. No profiles are published yet.</p>}
  <div class="grid cards">{characters.map(c => <a class="bordered" href={`/characters/${c.data.slugName}/`}>
    <h2>{c.data.knownAs}</h2>{isKnown(c.data.role) && <p>{c.data.role}</p>}
  </a>)}</div>
  <p>{isPublishedPath('/dragons/') && <>Explore the <a href="/dragons/">dragon type index</a> or </>}return to the <a href="/">Empyrean guide</a>.</p>
</BaseLayout>
