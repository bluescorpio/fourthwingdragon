---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublishedCharacter, isPublishedPath } from '../lib/publication';
import { getCollection } from 'astro:content';
import { isKnown, UNKNOWN } from '../lib/fields';
const characters = await getCollection('characters', isPublishedCharacter);
const dragons = await getCollection('dragons', ({ data }) => data.contentStatus === 'published' && isPublishedPath('/dragons/'));
---
<BaseLayout noindex={!isPublishedPath('/dragons/')} title="Fourth Wing Dragon Index: Empyrean Character Navigation Guide" description="Use the Fourth Wing dragon index to navigate this fan site, browse character references, and find links to Entangled Publishing." breadcrumbs={[{ name: 'Dragons', href: '/dragons/' }]}>
  <h1>Fourth Wing Dragon Index</h1>
  {dragons.length === 0 && <p class="muted">This page provides navigation to the character references and publisher pages.</p>}
  <div class="grid cards">{dragons.map(d => <article class="bordered"><h2>{d.data.name}</h2><p>{isKnown(d.data.summary) ? d.data.summary : UNKNOWN}</p></article>)}</div>
  <ul>{characters.map(c => <li><a href={`/characters/${c.data.slugName}/`}>{c.data.knownAs}</a></li>)}</ul>
  <p>Browse the <a href="/fourth-wing-characters/">character index</a> or return to the <a href="/">Empyrean guide</a>.</p>
</BaseLayout>
