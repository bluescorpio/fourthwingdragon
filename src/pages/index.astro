---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizRunner from '../components/quiz/QuizRunner.astro';
import StructuredData from '../components/StructuredData.astro';
import {dragonTypeQuiz} from '../lib/quizzes';
import {DEFAULT_TITLE,DEFAULT_DESCRIPTION} from '../lib/constants';
import { getCollection } from 'astro:content';
import { isPublishedCharacter } from '../lib/publication';
const characters = await getCollection('characters', isPublishedCharacter);
const features=[['/dragons/','Dragon Types','Compare seven color categories and six tail labels.'],['/quiz/dragon-type/','Dragon Quiz','Discover your original color personality profile.'],['/quiz/signet/','Signet Quiz','Explore seven creative ability themes.'],['/dragon-name-generator/','Name Generator','Combine invented syllables with Gaelic roots.'],['/guide-to-dragonkind/','Dragonkind Guide','Separate official resources from our fan tools.'],['/guides/threshing/','Threshing Guide','Read the context and follow the official introduction.']];
const faqs=[['Is this the official Fourth Wing quiz?','No. This independent fan quiz uses original personality mappings. It is not affiliated with the author or publisher. It is a fan activity inspired by the world of Basgiath War College and Threshing Day.'],['Do color results describe canonical personalities?','No. Quiz traits are our creative interpretations, separate from the dragon reference matrix. Browse Black, Blue, Green, Red, Orange, Brown and Iridescent categories, plus Daggertail, Morningstartail, Scorpiontail, Swordtail, Clubtail and Feathertail labels, as a site taxonomy rather than a canon claim.'],['Can I use the tools without an account?','Yes. Both quizzes and the name generator run in your browser without an account. The guide also points readers toward Iron Flame and Onyx Storm reading context without reproducing plot details.']];
---
<BaseLayout title={DEFAULT_TITLE} description={DEFAULT_DESCRIPTION}>
<p class="eyebrow">An unofficial Empyrean fan experience</p><h1>Fourth Wing Quiz &amp; Dragons: Every Type, Color and Tail</h1>
<div class="grid cards">{features.map(([href,label,summary])=><a class="bordered feature-card" href={href}><h2>{label}</h2><p>{summary}</p><span>Explore →</span></a>)}</div>
<QuizRunner quiz={dragonTypeQuiz}/>
<section class="bordered"><h2><a href="/fourth-wing-characters/">Fourth Wing Characters</a></h2><p>Browse the publisher's cadet descriptions and available character profiles.</p><ul>{characters.map(entry => <li><a href={`/characters/${entry.data.slugName}/`}>{entry.data.fullName ?? entry.data.knownAs}</a></li>)}</ul></section>
<section class="prose"><h2>A reader’s map to dragons and quizzes</h2><p>FourthWingDragon is an independent fan space for exploring the dragon vocabulary of Fourth Wing and trying original personality activities. The reference begins with a seven-by-six grid: choose a color, compare a tail label, and read the status attached to that intersection. A filled grid is a navigation tool, not a claim that every combination appears in the novels. Readers can use this map alongside their Empyrean reading, from Basgiath War College and Threshing Day references to the wider context of Iron Flame and Onyx Storm. The quizzes take a different approach. Their questions concern everyday decisions, and their results translate those choices into imaginative color or ability profiles. These interpretations belong to this site. They do not establish lore, predict a story outcome, or reproduce an official assessment. Use the name generator for a creative prompt, and follow our source notes when moving from playful interpretation to the author’s own introduction.</p></section>
<section class="prose"><h2>Common questions</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<StructuredData data={{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}}/>
<StructuredData data={{'@context':'https://schema.org','@type':'WebSite',name:'FourthWingDragon',url:'https://fourthwingdragon.com/',publisher:{'@type':'Organization',name:'FourthWingDragon',url:'https://fourthwingdragon.com/'}}}/>
</BaseLayout>
