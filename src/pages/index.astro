---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content';
const characters=await getCollection('characters');
---
<BaseLayout title="Fourth Wing Dragons & Characters — Empyrean Series Guide" description="A source-conscious fan guide to Fourth Wing dragons, Empyrean characters and the relationships between them." breadcrumbs={[]}><h1>Fourth Wing Dragons and Characters</h1><p class="muted">Explore a growing, source-conscious reference to the Empyrean series. Character pages separate confirmed details from research placeholders.</p><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:2rem"><a class="bordered" href="/fourth-wing-characters/"><h2>Fourth Wing Characters</h2><p>Browse one page per character.</p></a><a class="bordered" href="/dragons/"><h2>Dragon Types</h2><p>Review the dragon catalog and verification status.</p></a></div><section><h2>Featured character pages</h2><ul>{characters.map(c=><li><a href={`/characters/${c.data.slugName}/`}>{c.data.knownAs}</a></li>)}</ul></section></BaseLayout>
