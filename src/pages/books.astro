---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { amazonSearchUrl } from '../data/affiliate';
import { AFFILIATE_DISCLOSURE } from '../data/affiliates';

const title = 'Fourth Wing Books in Order: Reading Order and Where to Buy';
const description = 'Reading order for Fourth Wing, Iron Flame, Onyx Storm, and Threshing Day, with Amazon links for hardcover, paperback, Kindle, and audiobook.';
const formats = ['Hardcover', 'Paperback', 'Kindle', 'Audiobook'] as const;
const books = [
  { name: 'Fourth Wing', reader: 'Readers starting the numbered books.' },
  { name: 'Iron Flame', reader: 'Readers who have finished Fourth Wing.' },
  { name: 'Onyx Storm', reader: 'Readers who have finished Iron Flame.' },
  { name: 'Threshing Day', reader: 'Readers looking for the separate catalogue title.' },
];
const related = [
  ['/fourth-wing-book-4/', 'Fourth Wing Book 4: Release Date, Title and What We Know'],
  ['/fourth-wing-gift/', 'Fourth Wing Gift Ideas: By Recipient, Budget and Timing'],
  ['/fourth-wing-characters/', 'Fourth Wing Characters — Empyrean Cadet Names and Profiles'],
];
const buyUrl = (name: string, format: string) => amazonSearchUrl(`${name} Rebecca Yarros ${format.toLowerCase()}`);
const faqs = [
  { question: 'Is Peculiar Stars the fourth Fourth Wing book?', answer: 'No. Peculiar Stars is a standalone contemporary romance by Rebecca Yarros scheduled for 17 November 2026. The reading order above still has 4 titles.' },
  { question: 'When does Peculiar Stars come out?', answer: 'It is scheduled for 17 November 2026. A graphic-novel adaptation of Fourth Wing is separately scheduled for 6 April 2027.' },
  { question: 'Should I read Peculiar Stars before Onyx Storm?', answer: 'No. It is not part of the Empyrean series and does not belong in the publication-order reading list on this page.' },
];
---
<BaseLayout title={title} description={description} breadcrumbs={[{ name: 'Books', href: '/books/' }]}>
  <h1>{title}</h1>
  <article class="prose">
    <p class="purchase-disclosure">{AFFILIATE_DISCLOSURE} Links marked as affiliate earn a commission.</p>

    <h2>Suggested reading order</h2>
    <p>Read the numbered books in publication order: Fourth Wing, Iron Flame, then Onyx Storm. Threshing Day is a separate catalogue title, not the next numbered book. That next book has no official title or release date.</p>

    <h2>Who each book is for</h2>
    <ul>
      {books.map(book => <li><strong>{book.name}.</strong> {book.reader}</li>)}
    </ul>

    <h2>Where to buy</h2>
    <div class="table-scroll">
      <table class="bordered">
        <thead>
          <tr>
            <th scope="col">Book</th>
            {formats.map(format => <th scope="col">{format}</th>)}
          </tr>
        </thead>
        <tbody>
          {books.map(book => <tr>
            <th scope="row">{book.name}</th>
            {formats.map(format => <td>
              <a href={buyUrl(book.name, format)} rel="sponsored nofollow" target="_blank">{book.name} {format}<span class="affiliate-mark"> (affiliate)</span></a>
            </td>)}
          </tr>)}
        </tbody>
      </table>
    </div>

    <section aria-labelledby="beyond-the-empyrean-series">
      <h2 id="beyond-the-empyrean-series">Beyond the Empyrean series (2026)</h2>
      <p><strong>Short answer:</strong> <em>Peculiar Stars</em> is a standalone contemporary romance by Rebecca Yarros scheduled for 17 November 2026. It is not Empyrean book 4. The reading order above still has 4 titles.</p>
      <p>Rebecca Yarros writes outside the Empyrean universe. <em>Peculiar Stars</em> has its own characters and setting — not the fourth numbered Fourth Wing book, and not part of the reading order above.</p>
      <p>That distinction matters here: adding it to the table above would put a book about a different world into a list that is meant to be read in publication order. If you came to this page looking for the next Empyrean release, see <a href="/fourth-wing-book-4/">Fourth Wing Book 4: release date and what we know</a>. A graphic-novel adaptation of Fourth Wing is also scheduled for 6 April 2027; it is an adaptation of book one, not a new numbered entry.</p>
      <p>Read the Date column first: it is the only column that states a confirmed publication day.</p>
      <div class="table-scroll">
        <table class="bordered">
          <thead><tr><th scope="col">Dimension</th><th scope="col">Peculiar Stars</th><th scope="col">Empyrean book 4</th></tr></thead>
          <tbody>
            <tr><th scope="row">Series</th><td>Standalone contemporary romance</td><td>Fourth Wing series, numbered</td></tr>
            <tr><th scope="row">Date</th><td>17 November 2026</td><td>Not officially announced</td></tr>
            <tr><th scope="row">In the reading order above</th><td>No</td><td>Yes, when released</td></tr>
          </tbody>
        </table>
      </div>
      <p>The Series column is the one that keeps <em>Peculiar Stars</em> out of the numbered reading list on this page.</p>
    </section>

    <section aria-labelledby="related-pages">
      <h2 id="related-pages">Related pages</h2>
      <ul>{related.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq">Frequently asked questions</h2>
      {faqs.map(({ question, answer }) => <div class="faq-item"><strong>{question}</strong><p>{answer}</p></div>)}
    </section>
  </article>
  <StructuredData data={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) }} />
</BaseLayout>

<style>
  .faq-item { padding: 1rem 0; border-bottom: 1px solid var(--line); line-height: 1.75; }
</style>
