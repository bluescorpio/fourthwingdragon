---
import { characterStatuses, hrefIfLive } from '../lib/publication';
interface Props {
  slug: string;
  related: { name: string; slug?: string; href?: string }[];
  titles: Record<string, string>;
}
const { slug, related = [], titles } = Astro.props;
const statuses = await characterStatuses();
const picks = related.flatMap(item => {
  const raw = item.slug ? `/characters/${item.slug}/` : item.href;
  const href = hrefIfLive(raw, statuses);
  if (!href) return [];
  const character = href.match(/^\/characters\/([^/]+)\/$/);
  if (character?.[1] === slug) return [];
  const title = titles[href];
  if (!title) {
    console.warn(`TBD related title for ${href} on /characters/${slug}/`);
    return [];
  }
  return [{ title, href }];
});
---
{picks.length > 0 && <section class="bordered" aria-labelledby="related-pages">
  <h2 id="related-pages">Related pages</h2>
  <ul>{picks.map(item => <li><a href={item.href}>{item.title}</a></li>)}</ul>
</section>}
