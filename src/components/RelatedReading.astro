---
import { isPublishedPath } from '../lib/publication';
interface Props {
  slug: string;
  related: { name: string; slug?: string; href?: string }[];
  liveSlugs: string[];
}
const { slug, related = [], liveSlugs } = Astro.props;
const live = new Set(liveSlugs);
const picks = related.flatMap(item => {
  const href = item.slug ? `/characters/${item.slug}/` : item.href;
  if (!href || !isPublishedPath(href)) return [];
  const character = href.match(/^\/characters\/([^/]+)\/$/);
  if (character && (!live.has(character[1]) || character[1] === slug)) return [];
  return [{ name: item.name, href }];
});
---
{picks.length > 0 && <nav class="bordered" aria-label="Keep reading">
  <ul>{picks.map(item => <li><a href={item.href}>{item.name}</a></li>)}</ul>
</nav>}
