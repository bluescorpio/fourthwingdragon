---
import type { Quiz } from '../../lib/quizzes';
import { RESULT_NOTES } from '../../lib/quizzes';
interface Props {quiz:Quiz}
const {quiz}=Astro.props;
---
<quiz-runner id="quiz" class="quiz-panel bordered" data-quiz={JSON.stringify(quiz)} data-notes={JSON.stringify(RESULT_NOTES)}>
 <p class="notice share-invite"><strong>Share your result.</strong> Answer the questions for a picture of your match, with an original dragon. This site does not save it.</p>
 <div data-stage aria-live="polite"><h2>{quiz.title}</h2><p>{quiz.intro}</p><p class="muted">For entertainment. Our personality mappings are not canon. Answers stay in this browser tab.</p><button type="button" data-start>Start the quiz</button></div>
 <noscript><p>Enable JavaScript to answer this quiz. You can still <a href="/dragons/">browse every dragon category</a>.</p></noscript>
</quiz-runner>
<script>
 import {scoreQuiz,type Quiz,type QuizOption,type QuizResult} from '../../lib/quizzes';
 type Note = {title:string;text:string};
 class QuizRunner extends HTMLElement {
  private quiz!:Quiz;private answers:string[]=[];private stage!:HTMLElement;private notes:Note[]=[];private cardUrl='';
  connectedCallback(){if(this.dataset.ready)return;this.dataset.ready='true';this.quiz=JSON.parse(this.dataset.quiz??'{}') as Quiz;this.notes=JSON.parse(this.dataset.notes??'[]') as Note[];this.stage=this.querySelector('[data-stage]')!;this.querySelector('[data-start]')?.addEventListener('click',()=>this.start());}
  private node<K extends keyof HTMLElementTagNameMap>(tag:K,text?:string){const n=document.createElement(tag);if(text)n.textContent=text;return n;}
  private setStep(step:string){const url=new URL(window.location.href);url.searchParams.set('step',step);window.history.replaceState(null,'',url);}
  private start(){if(this.cardUrl){URL.revokeObjectURL(this.cardUrl);this.cardUrl='';}this.answers=[];this.question();}
  private question(){const i=this.answers.length;this.setStep(String(i+1));const q=this.quiz.questions[i];this.stage.replaceChildren();const progress=this.node('progress');progress.max=this.quiz.questions.length;progress.value=i;progress.setAttribute('aria-label','Quiz progress');this.stage.append(this.node('p','Question '+(i+1)+' of '+this.quiz.questions.length),progress);const heading=this.node('h2',q.prompt);heading.tabIndex=-1;this.stage.append(heading);const group=this.node('div');group.className='quiz-options';q.options.forEach((o:QuizOption)=>{const b=this.node('button',o.label);b.type='button';b.addEventListener('click',()=>{if(i!==this.answers.length)return;this.answers.push(o.id);this.answers.length===this.quiz.questions.length?void this.showResult():this.question();});group.append(b);});this.stage.append(group);const restart=this.node('button','Restart');restart.type='button';restart.className='secondary';restart.addEventListener('click',()=>this.start());this.stage.append(restart);heading.focus({preventScroll:true});}
  private pageUrl(){return window.location.origin+'/quiz/'+this.quiz.id+'/';}
  private message(result:QuizResult){return 'My FourthWingDragon match: '+result.title+'. '+result.traits.join(', ')+'. Fan-made, not canon. '+this.pageUrl();}
  private noteFor(id:string){if(!this.notes.length)return null;let index=0;for(const char of id)index+=char.charCodeAt(0);return this.notes[index%this.notes.length]??null;}
  private destinations(result:QuizResult){const page=this.pageUrl();const message=this.message(result);const title='My FourthWingDragon match: '+result.title;const q=encodeURIComponent;return [['X','https://x.com/intent/tweet?text='+q(message)],['Facebook','https://www.facebook.com/sharer/sharer.php?u='+q(page)+'&quote='+q(message)],['Tumblr','https://www.tumblr.com/widgets/share/tool?posttype=link&canonicalUrl='+q(page)+'&title='+q(title)+'&caption='+q(message)],['Reddit','https://www.reddit.com/submit?title='+q(title)+'&url='+q(page)],['WhatsApp','https://wa.me/?text='+q(message)],['Bluesky','https://bsky.app/intent/compose?text='+q(message)]] as const;}
  private targetLinks(result:QuizResult){const row=this.node('div');row.className='share-targets';for(const [label,href] of this.destinations(result)){const link=this.node('a',label);link.href=href;link.target='_blank';link.rel='noopener noreferrer';link.setAttribute('aria-label','Share on '+label+' (opens in a new tab)');row.append(link);}return row;}
  private async copyResult(message:string,status:HTMLElement){try{await navigator.clipboard.writeText(message);status.textContent='Result copied. Paste it wherever you like.';}catch{const area=this.node('textarea');area.value=message;area.readOnly=true;area.setAttribute('aria-label','Result text to copy');status.replaceChildren(this.node('span','Copy this result: '),area);area.select();}}
  private async deviceShare(message:string,status:HTMLElement){const share=navigator.share?.bind(navigator);if(!share){await this.copyResult(message,status);return;}try{await share({text:message});status.textContent='Result sent to the share sheet.';}catch(error){if(error instanceof DOMException&&error.name==='AbortError'){status.textContent='Share cancelled.';return;}await this.copyResult(message,status);}}
  private markFile(dimension:string){const file:Record<string,string>={valor:'red',loyalty:'green',cunning:'orange',ambition:'blue',resolve:'brown',insight:'golden',shadow:'black'};return '/share-dragons/'+(file[dimension]??'golden')+'.jpg';}
  private loadImage(src:string){return new Promise<HTMLImageElement>((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(new Error('mark'));img.src=src;});}
  private fileName(title:string){return 'fourthwingdragon-'+title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')+'.png';}
  private wrapLine(ctx:CanvasRenderingContext2D,text:string,max:number){const words=text.split(' ');const lines:string[]=[];let line='';for(const word of words){const next=line?line+' '+word:word;if(ctx.measureText(next).width>max&&line){lines.push(line);line=word;}else line=next;}if(line)lines.push(line);return lines;}
  private async paintCard(result:QuizResult){const img=await this.loadImage(this.markFile(result.dimension));const canvas=document.createElement('canvas');canvas.width=1080;canvas.height=1350;const ctx=canvas.getContext('2d');if(!ctx)throw new Error('canvas');ctx.fillStyle='#0c0a10';ctx.fillRect(0,0,1080,1350);ctx.drawImage(img,0,0,1080,1000);const fade=ctx.createLinearGradient(0,720,0,1020);fade.addColorStop(0,'rgba(12,10,16,0)');fade.addColorStop(1,'#0c0a10');ctx.fillStyle=fade;ctx.fillRect(0,720,1080,300);ctx.strokeStyle='#c9a227';ctx.lineWidth=8;ctx.strokeRect(28,28,1024,1294);ctx.textAlign='center';ctx.fillStyle='#c9a227';ctx.font='28px Georgia, serif';ctx.fillText('FOURWINGDRAGON',540,1060);ctx.fillStyle='#ede6d8';ctx.font='62px Georgia, serif';let y=1140;for(const line of this.wrapLine(ctx,result.title,940)){ctx.fillText(line,540,y);y+=72;}ctx.fillStyle='#c9a227';ctx.font='30px Georgia, serif';ctx.fillText(result.traits.join('  ·  '),540,y+8);ctx.fillStyle='#a79a87';ctx.font='24px Georgia, serif';ctx.fillText('Original dragon mark · not a book illustration',540,1290);const blob=await new Promise<Blob>((resolve,reject)=>canvas.toBlob(value=>value?resolve(value):reject(new Error('png')),'image/png'));return blob;}
  private saveCard(blob:Blob,title:string){const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=this.fileName(title);document.body.append(link);link.click();link.remove();URL.revokeObjectURL(url);}
  private async shareCard(blob:Blob,title:string,message:string,status:HTMLElement){const file=new File([blob],this.fileName(title),{type:'image/png'});const share=navigator.share?.bind(navigator);const can=typeof navigator.canShare==='function'&&navigator.canShare({files:[file]});if(share&&can){try{await share({files:[file],text:message});status.textContent='Image sent to the share sheet.';return;}catch(error){if(error instanceof DOMException&&error.name==='AbortError'){status.textContent='Share cancelled.';return;}}}this.saveCard(blob,title);status.textContent='Image downloaded. Attach it where you want to post.';}
  private shareControls(result:QuizResult,card:Blob|null){const message=this.message(result);const status=this.node('p');status.setAttribute('role','status');const copy=this.node('button','Copy text');copy.type='button';copy.className='secondary';copy.addEventListener('click',()=>void this.copyResult(message,status));const hint=this.node('p','The picture is made in this browser and is not a book illustration. Platform buttons send the text. Facebook attaches this quiz page.');hint.className='muted';const actions=this.node('div');if(card&&this.cardUrl){const preview=this.node('img');preview.className='share-card';preview.alt='Share card for '+result.title+'. Original dragon mark, not a book illustration.';preview.src=this.cardUrl;const download=this.node('button','Download image');download.type='button';download.addEventListener('click',()=>{this.saveCard(card,result.title);status.textContent='Image downloaded.';});const shareImage=this.node('button','Share image');shareImage.type='button';shareImage.className='secondary';shareImage.addEventListener('click',()=>void this.shareCard(card,result.title,message,status));actions.append(preview,download,shareImage);}actions.append(this.targetLinks(result),hint,copy,status);if(typeof navigator.share==='function'){const more=this.node('button','More on this device');more.type='button';more.className='secondary';more.addEventListener('click',()=>void this.deviceShare(message,status));actions.append(more);}const disclosure=this.node('p','As an Amazon Associate and Etsy Affiliate, I earn from qualifying purchases.');disclosure.className='purchase-disclosure';actions.append(disclosure);return {actions,copy};}
  private async showResult(){const result=scoreQuiz(this.quiz,this.answers);if(!result)return;this.setStep('result');let card:Blob|null=null;try{card=await this.paintCard(result);if(this.cardUrl)URL.revokeObjectURL(this.cardUrl);this.cardUrl=URL.createObjectURL(card);}catch{card=null;this.cardUrl='';}
   this.stage.replaceChildren();this.stage.append(this.node('p','Your fan-made match'));const heading=this.node('h2',result.title);heading.tabIndex=-1;this.stage.append(heading,this.node('p',result.description));const tags=this.node('ul');tags.className='traits';result.traits.forEach(trait=>tags.append(this.node('li',trait)));this.stage.append(tags,this.node('p','Personality mappings are our interpretation, not canon. This result is for entertainment. The dragon picture is an original mark.'));
   const panelControls=this.shareControls(result,card);const panel=this.node('div');panel.className='share-panel';panel.append(this.node('h3','Share your result'),this.node('p','Save the picture, or send the text. This site does not keep a copy.'),panelControls.actions);
   const again=this.node('button','Try again');again.type='button';again.className='secondary';again.addEventListener('click',()=>this.start());
   const all=this.node('a','See all seven color labels and six tail labels →');all.href='/dragons/';
   this.stage.append(panel,all,again);
   const note=this.noteFor(result.id);const dialog=this.node('dialog');dialog.className='result-dialog';dialog.setAttribute('aria-labelledby','share-dialog-title');const dialogControls=this.shareControls(result,card);const close=this.node('button','Back to your result');close.type='button';close.className='secondary';close.addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>panelControls.copy.focus());
   const title=this.node('h2','Share your result');title.id='share-dialog-title';dialog.append(title,this.node('p','Save the picture or post the text. This site does not save it.'),dialogControls.actions);
   if(note){dialog.append(this.node('h3',note.title),this.node('p',note.text),this.node('p','This note restates the public premise or how this site’s tools work. It is not a plot detail.'));const scope=dialog.lastElementChild;scope?.classList.add('muted');}
   dialog.append(close);this.stage.append(dialog);dialog.showModal();
  }
 }
 if(!customElements.get('quiz-runner'))customElements.define('quiz-runner',QuizRunner);
</script>
