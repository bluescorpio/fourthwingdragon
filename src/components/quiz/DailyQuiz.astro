---
import { dailyQuizQuestions, dailyQuizSchedule } from '../../data/daily-quiz';
const payload = { questions: dailyQuizQuestions, schedule: dailyQuizSchedule };
---
<daily-quiz id="quiz" class="daily-quiz bordered" data-quiz={JSON.stringify(payload)}>
  <div data-stage aria-live="polite">
    <p class="muted">Loading today’s challenge…</p>
  </div>
  <noscript><p>JavaScript is needed to play. You can still try the <a href="/quiz/dragon-type/">Dragon Quiz</a> or <a href="/quiz/signet/">Signet Quiz</a>.</p></noscript>
</daily-quiz>

<script>
  type Option = {id:string;text:string};
  type Question = {id:string;question:string;options:Option[];correctOptionId:string;explanation:string;sourceTitle:string;sourceUrl:string};
  type Answer = {questionId:string;optionId:string;correct:boolean};
  type RecordState = {challengeDate:string;answers:Answer[];currentIndex:number;complete:boolean;score:number};
  type Store = {version:1;records:Record<string,RecordState>;lastCompletedDate?:string;streak:number};
  type Payload = {questions:Question[];schedule:Record<string,string[]>};
  const STORAGE_KEY='fourthwing-daily-quiz:v1';
  class DailyQuiz extends HTMLElement {
    private stage!:HTMLElement; private payload!:Payload; private byId=new Map<string,Question>();
    private store:Store={version:1,records:{},streak:0}; private storageOk=true; private selected='';
    private activeDate=''; private timer=0;
    connectedCallback(){
      if(this.dataset.ready)return; this.dataset.ready='true'; this.stage=this.querySelector('[data-stage]')!;
      this.payload=JSON.parse(this.dataset.quiz??'{}') as Payload; this.payload.questions.forEach(q=>this.byId.set(q.id,q));
      this.readStore(); this.showFor(this.utcDate()); this.timer=window.setInterval(()=>this.tick(),1000);
      document.addEventListener('visibilitychange',()=>{if(!document.hidden)this.tick();});
    }
    disconnectedCallback(){window.clearInterval(this.timer);}
    private utcDate(date=new Date()){return date.toISOString().slice(0,10);}
    private questions(date:string){return (this.payload.schedule[date]??[]).map(id=>this.byId.get(id)).filter((q):q is Question=>Boolean(q));}
    private node<K extends keyof HTMLElementTagNameMap>(tag:K,text?:string){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}
    private readStore(){try{const raw=localStorage.getItem(STORAGE_KEY);if(raw){const parsed=JSON.parse(raw) as Store;if(parsed.version===1&&parsed.records)this.store=parsed;}localStorage.setItem(STORAGE_KEY,JSON.stringify(this.store));}catch{this.storageOk=false;}}
    private save(){if(!this.storageOk)return;try{const dates=Object.keys(this.store.records).sort().slice(-3);this.store.records=Object.fromEntries(dates.map(d=>[d,this.store.records[d]]));localStorage.setItem(STORAGE_KEY,JSON.stringify(this.store));}catch{this.storageOk=false;}}
    private tick(){const today=this.utcDate();const countdown=this.querySelector<HTMLElement>('[data-countdown]');if(countdown){const next=new Date();next.setUTCHours(24,0,0,0);const seconds=Math.max(0,Math.floor((next.getTime()-Date.now())/1000));const h=String(Math.floor(seconds/3600)).padStart(2,'0');const m=String(Math.floor(seconds%3600/60)).padStart(2,'0');const s=String(seconds%60).padStart(2,'0');countdown.textContent=`${h}:${m}:${s}`;}if(today!==this.activeDate&&!this.current()?.answers.length)this.showFor(today);}
    private current(){return this.store.records[this.activeDate];}
    private meta(date:string){const box=this.node('div');box.className='daily-meta';const dateLine=this.node('p');dateLine.append(this.node('strong',"Today's challenge"),document.createTextNode(` · ${date} UTC`));const reset=this.node('p','New challenge at 00:00 UTC · ');reset.className='muted';const count=this.node('span');count.dataset.countdown='';reset.append(count);box.append(dateLine,reset);return box;}
    private showFor(date:string){this.activeDate=date;this.selected='';const questions=this.questions(date);if(!questions.length){this.breakScreen(date);return;}const record=this.store.records[date];if(record?.complete){this.result(record);return;}if(record?.answers.length||record?.currentIndex){this.question(record);return;}this.intro(date);}
    private storageNote(){const p=this.node('p',this.storageOk?'Your progress is stored in this browser. Clearing browser data or changing devices may remove it.':'Progress may not be saved in this browser.');p.className='muted storage-note';return p;}
    private intro(date:string){this.stage.replaceChildren(this.meta(date));const h=this.node('h2','Three questions. One daily challenge.');this.stage.append(h,this.node('p','How well do you know the Empyrean? Each answer is locked only after you submit it.'));
      const scope=this.node('div');scope.className='notice';scope.append(this.node('strong','Fourth Wing spoiler notice'),this.node('p','This quiz may contain Fourth Wing spoilers. Later books are not included unless a question is limited to information in public publisher descriptions.'));
      const start=this.node('button','Start today’s challenge');start.type='button';start.addEventListener('click',()=>this.start(date));this.stage.append(scope,this.storageNote(),start);this.tick();}
    private start(date:string){const record:RecordState={challengeDate:date,answers:[],currentIndex:0,complete:false,score:0};this.store.records[date]=record;this.save();this.question(record);}
    private question(record:RecordState){const list=this.questions(record.challengeDate);const q=list[record.currentIndex];if(!q){this.breakScreen(record.challengeDate);return;}this.activeDate=record.challengeDate;this.selected='';this.stage.replaceChildren(this.meta(record.challengeDate));const progress=this.node('progress');progress.max=3;progress.value=record.currentIndex;progress.setAttribute('aria-label','Daily quiz progress');this.stage.append(this.node('p',`Question ${record.currentIndex+1} of 3`),progress);const h=this.node('h2',q.question);h.tabIndex=-1;this.stage.append(h);
      const field=this.node('fieldset');field.className='daily-options';const legend=this.node('legend','Choose one answer');field.append(legend);q.options.forEach(option=>{const label=this.node('label');const input=this.node('input');input.type='radio';input.name='daily-answer';input.value=option.id;input.addEventListener('change',()=>{this.selected=option.id;submit.disabled=false;});label.append(input,this.node('span',option.text));field.append(label);});
      const submit=this.node('button','Submit answer');submit.type='button';submit.disabled=true;submit.addEventListener('click',()=>this.submit(record,q));this.stage.append(field,submit,this.storageNote());const existing=record.answers.find(answer=>answer.questionId===q.id);if(existing){this.selected=existing.optionId;const input=this.stage.querySelector<HTMLInputElement>(`input[value="${existing.optionId}"]`);if(input)input.checked=true;this.feedback(record,q,existing.correct);}h.focus({preventScroll:true});this.tick();}
    private submit(record:RecordState,q:Question){if(!this.selected||record.answers.some(answer=>answer.questionId===q.id))return;const correct=this.selected===q.correctOptionId;record.answers.push({questionId:q.id,optionId:this.selected,correct});record.score=record.answers.filter(a=>a.correct).length;this.save();this.feedback(record,q,correct);}
    private feedback(record:RecordState,q:Question,correct:boolean){const submit=this.stage.querySelector<HTMLButtonElement>('button');if(submit)submit.disabled=true;this.stage.querySelectorAll<HTMLInputElement>('input').forEach(input=>{input.disabled=true;const label=input.closest('label');if(input.value===q.correctOptionId)label?.classList.add('answer-correct');if(input.checked&&input.value!==q.correctOptionId)label?.classList.add('answer-wrong');});const selected=q.options.find(o=>o.id===this.selected);const answer=q.options.find(o=>o.id===q.correctOptionId);const box=this.node('div');box.className=`answer-feedback ${correct?'is-correct':'is-wrong'}`;box.setAttribute('role','status');box.append(this.node('h3',correct?'Correct':'Not quite'),this.node('p',`You chose: ${selected?.text??'TBD'}. Correct answer: ${answer?.text??'TBD'}.`),this.node('p',q.explanation));const source=this.node('a',`Source: ${q.sourceTitle}`);source.href=q.sourceUrl;source.target='_blank';source.rel='noopener noreferrer';box.append(source);const next=this.node('button',record.currentIndex===2?'See result':'Next question');next.type='button';next.addEventListener('click',()=>{record.currentIndex+=1;if(record.currentIndex>=3){record.complete=true;this.complete(record);this.result(record);}else{this.save();this.question(record);}});this.stage.append(box,next);next.focus({preventScroll:true});}
    private complete(record:RecordState){const last=this.store.lastCompletedDate;if(last!==record.challengeDate){if(!last)this.store.streak=1;else if(record.challengeDate>last){const expected=new Date(`${last}T00:00:00Z`);expected.setUTCDate(expected.getUTCDate()+1);this.store.streak=this.utcDate(expected)===record.challengeDate?this.store.streak+1:1;this.store.lastCompletedDate=record.challengeDate;}else if(!this.store.streak)this.store.streak=1;if(!last||record.challengeDate>last)this.store.lastCompletedDate=record.challengeDate;}this.save();}
    private result(record:RecordState){this.activeDate=record.challengeDate;this.stage.replaceChildren();const h=this.node('h2','Daily Fourth Wing Quiz');h.tabIndex=-1;const messages=['A new flight begins. Come back for another challenge.','A promising start. There’s more to discover.','Well done, rider. One more question to master.','Perfect flight! You answered all three correctly.'];this.stage.append(h,this.node('p',`${record.challengeDate} UTC`),this.node('p',`Score: ${record.score}/3`),this.node('p',messages[record.score]??messages[0]));if(this.store.streak>0)this.stage.append(this.node('p',`Browser streak: ${this.store.streak} day${this.store.streak===1?'':'s'}`));const share=this.shareText(record);const copy=this.node('button','Copy result');copy.type='button';const status=this.node('p');status.setAttribute('role','status');copy.addEventListener('click',()=>void this.copy(share,status));this.stage.append(copy,status,this.storageNote());
      if(this.utcDate()!==record.challengeDate&&this.questions(this.utcDate()).length){const today=this.node('button',"Play today’s challenge");today.type='button';today.className='secondary';today.addEventListener('click',()=>this.showFor(this.utcDate()));this.stage.append(today);}
      const links=this.node('div');links.className='daily-next';[['/quiz/dragon-type/','Which dragon would choose you?'],['/quiz/signet/','Explore a fan-made signet'],['/fourth-wing-characters/','Browse Fourth Wing characters']].forEach(([href,label])=>{const a=this.node('a',label);a.href=href;links.append(a);});this.stage.append(links);h.focus({preventScroll:true});}
    private shareText(record:RecordState){const icons=record.answers.map(a=>a.correct?'🐉':'✨').join(' ');return `Daily Fourth Wing Quiz — ${record.challengeDate} UTC\n${icons}\nScore: ${record.score}/3\n\nTry today’s unofficial fan challenge:\nhttps://fourthwingdragon.com/quiz/daily-fourth-wing/`;}
    private async copy(text:string,status:HTMLElement){try{await navigator.clipboard.writeText(text);status.textContent='Result copied.';}catch{const area=this.node('textarea');area.value=text;area.readOnly=true;area.setAttribute('aria-label','Result text to copy manually');status.replaceChildren(this.node('span','Copy this result manually:'),area);area.select();}}
    private breakScreen(date:string){this.stage.replaceChildren(this.meta(date),this.node('h2',"Today's challenge is taking a short break."),this.node('p','Please check back soon.'));const links=this.node('p');links.append(this.link('/quiz/dragon-type/','Try the Dragon Quiz'),document.createTextNode(' or '),this.link('/quiz/signet/','take the Signet Quiz.'));this.stage.append(links);this.tick();}
    private link(href:string,label:string){const a=this.node('a',label);a.href=href;return a;}
  }
  if(!customElements.get('daily-quiz'))customElements.define('daily-quiz',DailyQuiz);
</script>
