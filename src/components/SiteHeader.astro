---
import { CORE_PAGES, SITE_NAME } from '../lib/constants';
---
<header class="site-header"><nav aria-label="Main"><a class="brand" href="/">{SITE_NAME}</a><div class="nav-links">{CORE_PAGES.map(p=><a href={p.href} aria-current={Astro.url.pathname===p.href?'page':undefined}>{p.label}</a>)}</div></nav></header>
